{
  "manifest_version": 2,
  "name": "Chrome Extension",
  "version": "0.1",
  "background": {
    "scripts": ["background.js"],
    "persistent" : false
  },
  "permissions": ["tabs", "https://192.168.1.11:5000/*"],
  "browser_action": {
    "default_icon": "ct.png",
    "default_popup": "sketch/index.html",
    "default_title": "Create a focus session!"
  },
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "http://*/",
    "https://*/"
  ]
}
