{
  "manifest_version": 2,
  "name": "Chrome Extension",
  "version": "0.1",
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": ["tabs", "https://172.20.10.6:5000/*"],
  "browser_action": {
    "default_icon": "ct.png",
    "default_popup": "sketch/index.html",
    "default_title": "Create a focus session!"
  },
  "permissions": [
    "tabs",
    "idle",
    "storage",
    "notifications",
    "http://*/",
    "https://*/"
  ],
  "content_security_policy": "script-src 'self' https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js; object-src 'self'"
}
